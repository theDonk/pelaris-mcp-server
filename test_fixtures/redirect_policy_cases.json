{
  "about": "OH-1 redirect policy case table (Pelaris 1.4 B2a lane C, C1). Shared with theDonk/pelaris-mcp-server; both repos pin the canonical SHA-256 (JSON.stringify(JSON.parse(file))). Synthetic hosts only. A row with pad_to pads uri with 'a' to that length.",
  "uri_cases": [
    { "name": "https any host", "uri": "https://chatgpt.com/connector/oauth/abc123", "custom_schemes": [], "expect": { "ok": true, "kind": "https" } },
    { "name": "https unmapped host", "uri": "https://client.example/cb", "custom_schemes": [], "expect": { "ok": true, "kind": "https" } },
    { "name": "https upper-case scheme", "uri": "HTTPS://Claude.ai/api/mcp/auth_callback", "custom_schemes": [], "expect": { "ok": true, "kind": "https" } },
    { "name": "http localhost", "uri": "http://localhost:3000/callback", "custom_schemes": [], "expect": { "ok": true, "kind": "loopback_http" } },
    { "name": "http 127.0.0.1", "uri": "http://127.0.0.1:6274/oauth/callback", "custom_schemes": [], "expect": { "ok": true, "kind": "loopback_http" } },
    { "name": "http [::1] (refused before C1)", "uri": "http://[::1]/cb", "custom_schemes": [], "expect": { "ok": true, "kind": "loopback_http" } },
    { "name": "http non-loopback", "uri": "http://evil.example/cb", "custom_schemes": [], "expect": { "ok": false, "reason": "http_not_loopback" } },
    { "name": "http localhost look-alike subdomain", "uri": "http://localhost.evil.example/cb", "custom_schemes": [], "expect": { "ok": false, "reason": "http_not_loopback" } },
    { "name": "http userinfo names localhost, host is elsewhere", "uri": "http://localhost@evil.example/cb", "custom_schemes": [], "expect": { "ok": false, "reason": "http_not_loopback" } },
    { "name": "http localhost port in userinfo", "uri": "http://localhost:3000@evil.example/cb", "custom_schemes": [], "expect": { "ok": false, "reason": "http_not_loopback" } },
    { "name": "http fragment names localhost", "uri": "http://evil.example#@localhost/cb", "custom_schemes": [], "expect": { "ok": false, "reason": "http_not_loopback" } },
    { "name": "javascript on a localhost host (registered before C1)", "uri": "javascript://localhost/x", "custom_schemes": [], "expect": { "ok": false, "reason": "refused_scheme" } },
    { "name": "javascript upper-case", "uri": "JAVASCRIPT:alert(1)", "custom_schemes": [], "expect": { "ok": false, "reason": "refused_scheme" } },
    { "name": "data", "uri": "data:text/html,hello", "custom_schemes": [], "expect": { "ok": false, "reason": "refused_scheme" } },
    { "name": "vbscript", "uri": "vbscript:msgbox(1)", "custom_schemes": [], "expect": { "ok": false, "reason": "refused_scheme" } },
    { "name": "file", "uri": "file:///tmp/x", "custom_schemes": [], "expect": { "ok": false, "reason": "refused_scheme" } },
    { "name": "blob", "uri": "blob:https://client.example/abc", "custom_schemes": [], "expect": { "ok": false, "reason": "refused_scheme" } },
    { "name": "filesystem", "uri": "filesystem:https://client.example/temporary/x", "custom_schemes": [], "expect": { "ok": false, "reason": "refused_scheme" } },
    { "name": "javascript even when listed", "uri": "javascript:alert(1)", "custom_schemes": ["javascript:"], "expect": { "ok": false, "reason": "refused_scheme" } },
    { "name": "intent never listable", "uri": "intent://cb#Intent;scheme=https;end", "custom_schemes": ["intent:"], "expect": { "ok": false, "reason": "refused_scheme" } },
    { "name": "about never listable", "uri": "about:blank", "custom_schemes": ["about:"], "expect": { "ok": false, "reason": "refused_scheme" } },
    { "name": "chrome never listable", "uri": "chrome://settings", "custom_schemes": ["chrome:"], "expect": { "ok": false, "reason": "refused_scheme" } },
    { "name": "a browser-switch scheme never listable", "uri": "googlechrome://evil.example/cb", "custom_schemes": ["googlechrome:"], "expect": { "ok": false, "reason": "refused_scheme" } },
    { "name": "a socket scheme never listable", "uri": "wss://evil.example/cb", "custom_schemes": ["wss:"], "expect": { "ok": false, "reason": "refused_scheme" } },
    { "name": "custom scheme not listed", "uri": "myapp://oauth/cb", "custom_schemes": [], "expect": { "ok": false, "reason": "custom_scheme_not_listed" } },
    { "name": "custom scheme listed", "uri": "myapp://oauth/cb", "custom_schemes": ["myapp:"], "expect": { "ok": true, "kind": "custom_scheme" } },
    { "name": "reverse-domain custom scheme listed", "uri": "com.example.app:/oauth2redirect", "custom_schemes": ["com.example.app:"], "expect": { "ok": true, "kind": "custom_scheme" } },
    { "name": "custom scheme listed with a bad shape is ignored", "uri": "myapp://oauth/cb", "custom_schemes": ["MyApp:"], "expect": { "ok": false, "reason": "custom_scheme_not_listed" } },
    { "name": "other custom scheme listed", "uri": "otherapp://cb", "custom_schemes": ["myapp:"], "expect": { "ok": false, "reason": "custom_scheme_not_listed" } },
    { "name": "empty string", "uri": "", "custom_schemes": [], "expect": { "ok": false, "reason": "unparseable" } },
    { "name": "not a URI", "uri": "not a uri", "custom_schemes": [], "expect": { "ok": false, "reason": "unparseable" } },
    { "name": "relative path", "uri": "/oauth/callback", "custom_schemes": [], "expect": { "ok": false, "reason": "unparseable" } },
    { "name": "leading space", "uri": " https://client.example/cb", "custom_schemes": [], "expect": { "ok": false, "reason": "unparseable" } },
    { "name": "tab inside the scheme", "uri": "java\tscript:alert(1)", "custom_schemes": [], "expect": { "ok": false, "reason": "unparseable" } },
    { "name": "newline inside", "uri": "https://client.example/\ncb", "custom_schemes": [], "expect": { "ok": false, "reason": "unparseable" } },
    { "name": "exactly 2048 characters", "uri": "https://client.example/", "pad_to": 2048, "custom_schemes": [], "expect": { "ok": true, "kind": "https" } },
    { "name": "2049 characters", "uri": "https://client.example/", "pad_to": 2049, "custom_schemes": [], "expect": { "ok": false, "reason": "too_long" } }
  ],
  "list_cases": [
    { "name": "one good", "uris": ["https://chatgpt.com/connector/oauth/abc123"], "custom_schemes": [], "expect": { "ok": true } },
    { "name": "ten good", "uris": ["https://a.example/1", "https://a.example/2", "https://a.example/3", "https://a.example/4", "https://a.example/5", "https://a.example/6", "https://a.example/7", "https://a.example/8", "https://a.example/9", "https://a.example/10"], "custom_schemes": [], "expect": { "ok": true } },
    { "name": "eleven", "uris": ["https://a.example/1", "https://a.example/2", "https://a.example/3", "https://a.example/4", "https://a.example/5", "https://a.example/6", "https://a.example/7", "https://a.example/8", "https://a.example/9", "https://a.example/10", "https://a.example/11"], "custom_schemes": [], "expect": { "ok": false, "reason": "too_many", "index": null } },
    { "name": "empty list", "uris": [], "custom_schemes": [], "expect": { "ok": false, "reason": "missing", "index": null } },
    { "name": "not a list", "uris": "https://a.example/cb", "custom_schemes": [], "expect": { "ok": false, "reason": "missing", "index": null } },
    { "name": "second refused", "uris": ["https://a.example/cb", "javascript://localhost/x"], "custom_schemes": [], "expect": { "ok": false, "reason": "refused_scheme", "index": 1 } },
    { "name": "a non-string entry", "uris": ["https://a.example/cb", 42], "custom_schemes": [], "expect": { "ok": false, "reason": "unparseable", "index": 1 } }
  ],
  "dial_cases": [
    { "name": "missing doc", "doc": null, "expect_custom_schemes": [] },
    { "name": "not a list", "doc": { "custom_schemes": "myapp:" }, "expect_custom_schemes": [] },
    { "name": "valid entries kept", "doc": { "custom_schemes": ["myapp:", "com.example.app:"] }, "expect_custom_schemes": ["myapp:", "com.example.app:"] },
    { "name": "never-listable and refused dropped", "doc": { "custom_schemes": ["http:", "https:", "intent:", "about:", "chrome:", "javascript:", "data:", "file:", "myapp:"] }, "expect_custom_schemes": ["myapp:"] },
    { "name": "browser-switch, socket and system schemes dropped", "doc": { "custom_schemes": ["googlechrome:", "x-safari-https:", "microsoft-edge:", "ws:", "wss:", "ftp:", "mailto:", "tel:", "sms:", "view-source:", "jar:", "firefox:", "opera-http:", "googlechromes:", "myapp:"] }, "expect_custom_schemes": ["myapp:"] },
    { "name": "bad shapes dropped", "doc": { "custom_schemes": ["MyApp:", "myapp", "1app:", "my app:", "", 7, null, "ok-app:"] }, "expect_custom_schemes": ["ok-app:"] },
    { "name": "duplicates once", "doc": { "custom_schemes": ["myapp:", "myapp:"] }, "expect_custom_schemes": ["myapp:"] },
    { "name": "capped at ten", "doc": { "custom_schemes": ["a1:", "a2:", "a3:", "a4:", "a5:", "a6:", "a7:", "a8:", "a9:", "a10:", "a11:"] }, "expect_custom_schemes": ["a1:", "a2:", "a3:", "a4:", "a5:", "a6:", "a7:", "a8:", "a9:", "a10:"] }
  ]
}
